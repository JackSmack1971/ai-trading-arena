{
  "name": "trader-arena",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first AI paper-trading simulator arena",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @arena/web dev",
    "dev:api": "pnpm --filter @arena/api dev",
    "dev:worker": "pnpm --filter @arena/worker dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @arena/db migrate",
    "strategy:create": "tsx scripts/create-strategy.ts",
    "sim:replay": "pnpm --filter @arena/worker replay"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "eslint": "^9.0.0",
    "knip": "^5.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vite-tsconfig-paths": "^4.3.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
