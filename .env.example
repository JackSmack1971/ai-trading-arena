# ── OpenRouter ────────────────────────────────────────────────────────────────
# Required: get a free key at https://openrouter.ai
OPENROUTER_API_KEY=

# ── API server ────────────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
DB_FILE_NAME=./data/arena.db

# ── Vite frontend (prefix with VITE_ to expose to the browser) ────────────────
VITE_API_BASE_URL=http://127.0.0.1:3001
VITE_WS_BASE_URL=ws://127.0.0.1:3001

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Optional: site attribution for OpenRouter headers ────────────────────────
HTTP_REFERER=http://localhost:3000
OPENROUTER_SITE_TITLE=AI Trading Arena
