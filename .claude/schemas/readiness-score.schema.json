{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReadinessScorecard",
  "description": "Standardized schema for production-readiness evaluations of Claude Code configurations.",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["pass", "pass_with_warnings", "fail", "blocked"]
    },
    "readiness_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "readiness_band": {
      "type": "string",
      "enum": [
        "Critical Risk",
        "Remediation Required",
        "Production Ready",
        "Elite Orchestration"
      ]
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "scope_clarity": { "$ref": "#/definitions/DimensionScore" },
        "routing_description_quality": { "$ref": "#/definitions/DimensionScore" },
        "tool_minimality": { "$ref": "#/definitions/DimensionScore" },
        "reasoning_depth": { "$ref": "#/definitions/DimensionScore" },
        "context_efficiency": { "$ref": "#/definitions/DimensionScore" },
        "verification_discipline": { "$ref": "#/definitions/DimensionScore" },
        "safety_controls": { "$ref": "#/definitions/DimensionScore" },
        "maintainability": { "$ref": "#/definitions/DimensionScore" },
        "handoff_quality": { "$ref": "#/definitions/DimensionScore" },
        "source_grounding": { "$ref": "#/definitions/DimensionScore" }
      },
      "additionalProperties": false
    },
    "critical_findings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_edits": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verification_evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "residual_risks": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [
    "status",
    "readiness_score",
    "readiness_band",
    "dimensions"
  ],
  "definitions": {
    "DimensionScore": {
      "type": "object",
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "fix": {
          "type": "string"
        }
      },
      "required": ["score", "evidence"]
    }
  }
}
